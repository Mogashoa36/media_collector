    "version": "0.2.0",
    "configurations": [
    {
        "command": "ng s",
        "name": "Run npm start",
        "request": "launch",
        "type": "node-terminal",
        "cwd": "${workspaceFolder}/collector_front/collector_frontend"
    },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "CollectorApplication",
            "request": "launch",
            "mainClass": "media.collector.CollectorApplication",
            "projectName": "collector"
        }
    ]
}
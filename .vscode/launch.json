{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Ollama Server",
            "type": "node-terminal",
            "request": "launch",
            "command": "ollama serve",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Angular Frontend",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm start",
            "cwd": "${workspaceFolder}/collector_front/collector_frontend"
        },
        {
            "name": "Spring Boot Backend",
            "type": "java",
            "request": "launch",
            "mainClass": "media.collector.CollectorApplication",
            "projectName": "collector"
        },
        {
            "name": "Current Java File",
            "type": "java",
            "request": "launch",
            "mainClass": "${file}"
        }
    ],
    "compounds": [
        {
            "name": "Start Full Stack",
            "configurations": [
                "Ollama Server",
                "Angular Frontend",
                "Spring Boot Backend"
            ],
            "stopAll": true
        }
    ]
}